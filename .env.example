# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -base64 32

# Database password for the non-superuser "chatbot" role.
POSTGRES_PASSWORD=
# Standalone compose only: password for the postgres admin user.
POSTGRES_ADMIN_PASSWORD=

# 32 random bytes, base64. Encrypts provider credentials stored in the database.
# Keep a copy OUTSIDE the server and outside database backups, or stored credentials are lost.
APP_ENCRYPTION_KEY=

# Shared secret between app and whatsapp-gateway (internal network only). Min 24 chars.
GATEWAY_TOKEN=
# mock = no real WhatsApp. The real QR driver arrives in Phase 2.
GATEWAY_DRIVER=mock

# pibot.io deployment (deploy/pibot)
APP_HOST=bot.pibot.io
TLS_EMAIL=

# First platform owner, used once by `npm run seed` (synthetic demo data).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
