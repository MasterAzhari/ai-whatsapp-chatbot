{
  "name": "@chatbot/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 'dist/test/**/*.test.js'",
    "migrate": "node dist/src/cli/migrate.js",
    "seed": "node dist/src/cli/seed.js",
    "worker": "node dist/src/cli/worker.js"
  },
  "dependencies": {
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "typescript": "5.9.2"
  }
}
